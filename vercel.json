{
	"buildCommand": "pnpm turbo run build",
	"outputDirectory": ".",
	"installCommand": "pnpm install --no-frozen-lockfile",
	"framework": null,
	"rewrites": [
		{
			"source": "/nuxt(/?)",
			"destination": "/apps/nuxt-site/.output/public/index.html"
		},
		{
			"source": "/nuxt/:path*",
			"destination": "/apps/nuxt-site/.output/public/:path*"
		},
		{
			"source": "/vue/:path*",
			"destination": "/apps/vue-spa/dist/:path*"
		},
		{
			"source": "/",
			"destination": "/apps/landing/index.html"
		}
	]
}
